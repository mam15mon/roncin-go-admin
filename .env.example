# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_DB=roncin_go_admin
POSTGRES_USER=roncin
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_SOURCE=postgresql://roncin:replace-with-a-local-password@127.0.0.1:5432/roncin_go_admin?sslmode=disable
KRATOS_DATABASE_SOURCE=postgresql://roncin:replace-with-a-local-password@127.0.0.1:5432/roncin_go_admin?sslmode=disable

# -----------------------------------------------------------------------------
# Bootstrap Superadmin Configuration
# -----------------------------------------------------------------------------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
BOOTSTRAP_ORGANIZATION_CODE=HQ
BOOTSTRAP_ORGANIZATION_NAME=总部

# -----------------------------------------------------------------------------
# WeChat Work (企业微信) Login Configuration
# -----------------------------------------------------------------------------
WECOM_ENABLED=false
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_REDIRECT_URI=

# -----------------------------------------------------------------------------
# DingTalk (钉钉) Login and Notification Configuration
# 应用需要通讯录成员查询权限，并在“机器人与消息推送”中启用企业内部机器人。
# -----------------------------------------------------------------------------
DINGTALK_ENABLED=false
DINGTALK_CORP_ID=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_REDIRECT_URI=
DINGTALK_REGISTRATION_TOKEN_SECRET=replace-with-at-least-32-random-characters

# -----------------------------------------------------------------------------
# OpenTelemetry Tracing Configuration
# -----------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=127.0.0.1:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_ARG=1
