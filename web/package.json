{
  "name": "@roncin/web",
  "version": "0.1.0",
  "private": true,
  "description": "An out-of-box UI solution for enterprise applications",
  "repository": "git@github.com:ant-design/ant-design-pro.git",
  "scripts": {
    "build": "vite build",
    "deploy": "vite build && gh-pages -d dist",
    "dev": "vite --mode dev",
    "lint": "pnpm run biome:lint && pnpm run tsc",
    "lint-staged": "lint-staged",
    "biome:lint": "biome lint",
    "biome": "biome check --write",
    "openapi": "node scripts/generate-openapi-input.mjs && node scripts/generate-services.mjs",
    "prepare": "husky",
    "preview": "vite preview",
    "preview:build": "vite build && vite preview",
    "start": "vite --mode dev",
    "start:pre": "node --env-file-if-exists=../.env.local ../scripts/run-with-env.mjs vite --mode pre",
    "start:test": "node --env-file-if-exists=../.env.local ../scripts/run-with-env.mjs vite --mode test",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "doctor": "react-doctor .",
    "tsc": "tsc --noEmit"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/pro-components": "^3.1.14-2",
    "@sentry/react": "^10.74.0",
    "@tanstack/react-query": "^5.103.1",
    "antd": "^6.6.0",
    "antd-style": "^4.1.0",
    "axios": "^1.20.0",
    "china-division": "^2.7.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "decimal.js": "10.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@ant-design/cli": "^6.6.2",
    "@babel/parser": "^7.29.8",
    "@biomejs/biome": "^2.5.3",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-helmet": "^6.1.11",
    "@umijs/openapi": "^1.14.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "express": "^5.2.1",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "less": "^4.9.1",
    "lint-staged": "^17.3.0",
    "mockjs": "^1.1.0",
    "react-doctor": "^0.9.11",
    "react-router": "^8.4.0",
    "swagger-ui-dist": "^5.32.8",
    "tailwindcss": "^4.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "7.2.2",
    "vitest": "4.1.10",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.33.4"
}
